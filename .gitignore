# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# SQLite & local cache
backend/vision_cache.db*
*.db-wal
*.db-shm

# Backup and temp files
backend/archive/
backend/*.bak
backend/output.txt
backend/output_all.txt
# Đợt 4I security fix: `backend/.env.bak_keys` was sitting UNTRACKED in the
# working tree with SIX live secrets inside (Groq, Gemini, OpenRouter, HuggingFace
# Space token, both TypeSafe keys). No rule matched it — `backend/*.bak` does not
# match `.bak_keys`, and `backend/.env` does not either — so one `git add -A`
# would have pushed them into history for good: the leaked-TypeSafe-key incident
# all over again. It was never committed, so no history rewrite is needed.
backend/.env.bak_keys
*.bak_keys

# Environment variables
backend/.env
.env
.env.local
.env.*.local

# Node
node_modules/
.next/
out/
build/
dist/

# Phase 0 security fix: runtime DB + local artifacts
backend/*.db
*.db
backend/*.log
duosteam.worktrees/

# Phase 4: MathLive assets are copied from node_modules by postinstall
frontend/public/mathlive-fonts/
frontend/public/mathlive-sounds/
