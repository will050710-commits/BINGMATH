# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Environment variables
.env
# Đợt 4I security fix: a key dump named `.env.bak_keys` matched no rule here
# (`*.bak` requires the extension to BE `bak`; `.env` requires the name to BE
# `.env`), so it sat untracked with live secrets one `git add -A` away from
# history. Same lesson as the leaked TypeSafe keys.
.env.bak_keys
*.bak_keys

# SQLite & Cache databases
vision_cache.db
vision_cache.db-wal
vision_cache.db-shm
*.db-wal
*.db-shm

# Backup and temp files
*.bak
archive/
output.txt
output_all.txt

# Phase 0: never track the runtime database or logs again
*.db
*.log
