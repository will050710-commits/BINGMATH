# Groq API (Socratic math hint generation)
GROQ_API_KEY=your_groq_api_key_here

# Google Gemini API (Core Math reasoning & Vision)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.6-flash

# OCR Settings
OCR_ENABLED=true
OCR_SPACES_ID=baidu/Unlimited-OCR

# OpenRouter Free-Tier Vision Agent (Olympiad Geometry)
OPENROUTER_API_KEY=your_openrouter_api_key_here
OPENROUTER_VISION_MODEL=qwen/qwen2.5-vl-72b-instruct:free
OPENROUTER_VISION_FALLBACK_MODELS=qwen/qwen2.5-vl-32b-instruct:free,google/gemma-3-27b-it:free
VISION_AGENT_ENABLED=true

# Custom SOTA Math & Canvas Provider (Hugging Face / vLLM / Ollama / Together / RunPod)
# Options: "gemini" (default) | "huggingface" | "openai_compatible"
LLM_PROVIDER=gemini
HF_MODEL_NAME=deepseek-ai/DeepSeek-R1-Distill-Qwen-7B
HF_API_KEY=your_huggingface_token_here
OPENAI_COMPATIBLE_BASE_URL=https://api-inference.huggingface.co/v1
OPENAI_COMPATIBLE_API_KEY=your_api_key_here

# Problem Bank & Semantic Embeddings RAG (Track A)
MATH_PROBLEM_INDEX_PATH=data/math_problems.jsonl
MATH_EMBEDDING_MODEL=AITeamVN/Vietnamese_Embedding
# Optional lightweight model: intfloat/multilingual-e5-small
# MATH_EMBEDDING_QUERY_PREFIX=query: 
# MATH_EMBEDDING_PASSAGE_PREFIX=passage: 

# Debugging / Coordinate Grid Overlay for Vision
VISION_GRID_OVERLAY=false


