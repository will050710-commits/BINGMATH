# Groq API (Socratic math hint generation)
GROQ_API_KEY=your_groq_api_key_here

# Google Gemini API (Core Math reasoning & Vision)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.6-flash

# OCR Settings
OCR_ENABLED=true
OCR_SPACES_ID=baidu/Unlimited-OCR

# ── OpenRouter — free-tier ladders (Phase 4, kiểm chứng live 26/09/2026) ─────
# OpenRouter chỉ nhận TỐI ĐA 3 model trong mảng `models`, và một slug chết làm
# hỏng CẢ request (HTTP 400) — code tự loại slug chết / model bị 429 rồi thử lại.
OPENROUTER_API_KEY=your_openrouter_api_key_here
# Thang thị giác (MathReader đọc từng model theo thứ tự khai báo)
OPENROUTER_VISION_MODEL=qwen/qwen3.8-27b:free
OPENROUTER_VISION_FALLBACK_MODELS=google/gemma-4-31b-it:free,dots-studio/dots-3-note-preview:free,thinkingmachines/inkling:free,openrouter/free
# Thang cho chat / dịch / sửa JSON MathViz
OPENROUTER_CHAT_MODELS=qwen/qwen3.8-27b:free,nvidia/nemotron-3-ultra-550b-a55b:free,openrouter/free
OPENROUTER_TRANSLATE_MODELS=qwen/qwen3.8-27b:free,nvidia/nemotron-3-ultra-550b-a55b:free,openrouter/free
OPENROUTER_REPAIR_MODEL=qwen/qwen3.8-27b:free
# Nhà cung cấp trả lời /api/translate trước (openrouter|gemini|groq, theo thứ tự)
TRANSLATE_TIER_ORDER=openrouter,gemini,groq
# Hạn mức free dùng chung: 50 req/ngày khi chưa nạp credit, 1000 req/ngày sau khi
# nạp ≥ $10. 0 = tắt chốt bảo vệ.
OPENROUTER_DAILY_BUDGET=800
VISION_AGENT_ENABLED=true

# ── Phase 4 / Đợt 4A — nhận diện có kiểm chứng (MathReader) ─────────────────
# Hai reader KHÁC HỌ model để lỗi hệ thống không trùng nhau.
# AI_DUAL_READ: auto (chỉ đọc lần 2 khi mơ hồ) | always | never (tắt, rollback)
MATH_READER_MODELS=qwen/qwen3.8-27b:free,google/gemma-4-31b-it:free
MATH_READER_TIEBREAK_MODEL=dots-studio/dots-3-note-preview:free
AI_DUAL_READ=auto

# ── Phase 4 / Đợt 4B — bộ giải có tool SymPy + hậu kiểm ─────────────────────
MATH_TOOLS_MODEL=qwen/qwen3.8-27b:free,nvidia/nemotron-3-ultra-550b-a55b:free,openrouter/free
MATH_CRITIC_MODEL=google/gemma-4-31b-it:free,nvidia/nemotron-3-ultra-550b-a55b:free,openrouter/free
# auto = chỉ kiểm khi có căn cứ | always = luôn kiểm | off = tắt
MATH_VERIFY_MODE=auto

# ── Phase 4 / Đợt 4C — retention của bảng telemetry ai_quality_log (ngày) ───
AI_QUALITY_RETENTION_DAYS=90

# ── Phase 4 / Đợt 4E — ôn tập giãn cách FSRS ───────────────────────────────
# Xác suất ghi nhớ mục tiêu cho bộ lập lịch (kẹp trong 0.70–0.97)
FSRS_DESIRED_RETENTION=0.9

# ── Tuỳ chọn: middleware TypeSafe/Jev (guard vẫn chạy khi thiếu khoá) ───────
# TYPESAFE_API_KEY_PRIMARY=your_typesafe_primary_key
# TYPESAFE_API_KEY_SECONDARY=your_typesafe_secondary_key

# Custom SOTA Math & Canvas Provider (Hugging Face / vLLM / Ollama / Together / RunPod)
# Options: "gemini" (default) | "huggingface" | "openai_compatible"
LLM_PROVIDER=gemini
HF_MODEL_NAME=deepseek-ai/DeepSeek-R1-Distill-Qwen-7B
HF_API_KEY=your_huggingface_token_here
OPENAI_COMPATIBLE_BASE_URL=https://api-inference.huggingface.co/v1
OPENAI_COMPATIBLE_API_KEY=your_api_key_here

# Problem Bank & Semantic Embeddings RAG (Track A)
MATH_PROBLEM_INDEX_PATH=data/math_problems.jsonl
MATH_EMBEDDING_MODEL=AITeamVN/Vietnamese_Embedding
# Optional lightweight model: intfloat/multilingual-e5-small
# MATH_EMBEDDING_QUERY_PREFIX=query: 
# MATH_EMBEDDING_PASSAGE_PREFIX=passage: 

# Debugging / Coordinate Grid Overlay for Vision
VISION_GRID_OVERLAY=false


